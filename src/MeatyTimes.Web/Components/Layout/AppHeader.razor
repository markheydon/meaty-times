<header class="bg-white border-b border-gray-200">
    <div class="max-w-6xl mx-auto px-4 py-3 flex flex-wrap items-center justify-between gap-3">
        <div class="flex items-center gap-2 text-primary shrink-0">
            <LucideIcon Name="utensils" Size="24" Class="text-primary" />
            <span class="text-xl font-bold tracking-tight text-gray-900">MeatyTimes</span>
        </div>

        <nav class="flex flex-wrap items-center gap-2" aria-label="Main navigation">
            <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-primary text-white text-sm font-medium"
                  aria-current="page">
                <LucideIcon Name="calculator" Size="16" />
                Calculator
            </span>
            <span class="inline-flex items-center gap-1.5 px-3 py-1.5 text-sm text-gray-500 cursor-default select-none"
                  aria-disabled="true">
                <LucideIcon Name="clock" Size="16" />
                History
            </span>
            <span class="inline-flex items-center gap-1.5 px-3 py-1.5 text-sm text-gray-500 cursor-default select-none"
                  aria-disabled="true">
                <LucideIcon Name="book" Size="16" />
                Guides
            </span>
            <span class="inline-flex items-center gap-1.5 px-3 py-1.5 text-sm text-gray-500 cursor-default select-none"
                  aria-disabled="true">
                <LucideIcon Name="info" Size="16" />
                About
            </span>
        </nav>
    </div>
</header>
