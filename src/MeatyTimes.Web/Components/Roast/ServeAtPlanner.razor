@using MeatyTimes.Web.Services

@if (Schedule is not null || !string.IsNullOrEmpty(Error))
{
    <div class="mt-4">
        @if (Schedule is not null)
        {
            @if (!Schedule.IsAchievable)
            {
                <div class="flex items-start gap-2 rounded-lg bg-amber-50 border border-amber-200 p-3 text-sm text-amber-900" role="alert">
                    <LucideIcon Name="info" Size="18" Class="shrink-0 mt-0.5" />
                    <div>
                        <p class="font-medium">This serving time is too soon.</p>
                        @if (Schedule.EarliestServingTime is { } earliest)
                        {
                            var localEarliest = earliest.ToLocalTime();
                            <p class="mt-1">Earliest possible: @localEarliest.ToString("HH:mm") on @localEarliest.ToString("d MMMM").</p>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="rounded-lg border border-gray-200 bg-white p-4 space-y-2">
                    <h3 class="text-sm font-semibold text-gray-900 mb-3">Schedule</h3>
                    <div class="flex items-center gap-2 text-sm text-gray-700">
                        <LucideIcon Name="play" Size="16" Class="text-primary shrink-0" />
                        <span>Start cooking: <strong>@FormatLocalTime(Schedule.StartCookingTime)</strong></span>
                    </div>
                    @if (Schedule.TemperatureChangeTime is { } changeTime)
                    {
                        <div class="flex items-center gap-2 text-sm text-gray-700">
                            <LucideIcon Name="thermostat" Size="16" Class="text-primary shrink-0" />
                            <span>Reduce temperature: <strong>@FormatLocalTime(changeTime)</strong></span>
                        </div>
                    }
                    <div class="flex items-center gap-2 text-sm text-gray-700">
                        <LucideIcon Name="oven" Size="16" Class="text-primary shrink-0" />
                        <span>Remove from oven: <strong>@FormatLocalTime(Schedule.RemoveFromOvenTime)</strong></span>
                    </div>
                    <div class="flex items-center gap-2 text-sm text-gray-700">
                        <LucideIcon Name="hourglass" Size="16" Class="text-primary shrink-0" />
                        <span>Resting begins: <strong>@FormatLocalTime(Schedule.RestingStartTime)</strong></span>
                    </div>
                </div>
            }
        }

        @if (!string.IsNullOrEmpty(Error))
        {
            <div class="mt-3 flex items-start gap-2 rounded-lg bg-red-50 border border-red-200 p-3 text-sm text-red-800" role="alert">
                <LucideIcon Name="info" Size="18" Class="shrink-0 mt-0.5" />
                <p>@Error</p>
            </div>
        }
    </div>
}

@code {
    [Parameter] public ScheduleDto? Schedule { get; set; }

    [Parameter] public string? Error { get; set; }

    private static string FormatLocalTime(DateTimeOffset? value) =>
        value?.ToLocalTime().ToString("HH:mm") ?? string.Empty;
}
