@inherits LayoutComponentBase

<AppHeader />

<main class="min-h-[calc(100vh-57px)] bg-page">
    <div class="max-w-6xl mx-auto px-4 py-6">
        @Body
    </div>
</main>

<div id="blazor-error-ui" data-nosnippet class="hidden fixed bottom-0 left-0 right-0 bg-red-600 text-white p-3 z-50">
    An unhandled error has occurred.
    <a href="." class="underline ml-2">Reload</a>
    <button type="button" class="dismiss ml-4">✕</button>
</div>
