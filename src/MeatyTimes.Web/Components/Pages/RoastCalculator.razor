@page "/"
@using MeatyTimes.Web.Components.Roast
@using MeatyTimes.Web.Services
@inject RoastService RoastService

<PageTitle>MeatyTimes — Roast Calculator</PageTitle>

@if (_loadError is not null)
{
    <div class="rounded-lg bg-red-50 border border-red-200 p-4 text-sm text-red-800" role="alert">
        @_loadError
    </div>
}
else
{
    <div class="flex flex-col md:flex-row gap-6">
        <div class="w-full md:w-2/5 shrink-0">
            <RoastInputForm Meats="_meats"
                            IsLoading="_isLoading"
                            OnCalculateRequested="HandleCalculate"
                            WeightError="@_weightError"
                            DonenessError="@_donenessError" />
        </div>

        <div class="w-full md:w-3/5 flex flex-col gap-0">
            @if (!string.IsNullOrEmpty(_generalError))
            {
                <div class="mb-4 rounded-lg bg-red-50 border border-red-200 p-4 text-sm text-red-800" role="alert">
                    @_generalError
                </div>
            }

            <RoastResultsDisplay Result="_result"
                                 Input="_lastInput"
                                 Meats="_meats" />

            <ServeAtPlanner Schedule="_schedule"
                            Error="@_scheduleError" />
        </div>
    </div>

    <div class="mt-6 flex items-start gap-3 rounded-lg bg-tip border border-tip-border p-4 text-sm text-gray-700">
        <LucideIcon Name="lightbulb" Size="20" Class="text-amber-500 shrink-0 mt-0.5" />
        <p><strong>Tip:</strong> For best results, use a meat thermometer to check your roast is cooked through. Cooking times are estimates and may vary.</p>
    </div>
}

@code {
    private IReadOnlyList<MeatTypeDto> _meats = [];
    private CookingResultDto? _result;
    private ScheduleDto? _schedule;
    private RoastInputForm.RoastInputModel? _lastInput;
    private bool _isLoading;
    private string? _loadError;
    private string? _generalError;
    private string? _weightError;
    private string? _donenessError;
    private string? _scheduleError;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await Task.Yield();
            _meats = RoastService.GetMeats();
        }
        catch (Exception ex)
        {
            _loadError = $"Could not load meat types. {ex.Message}";
        }
    }

    private async Task HandleCalculate(RoastInputForm.RoastInputModel input)
    {
        _isLoading = true;
        _generalError = null;
        _weightError = null;
        _donenessError = null;
        _scheduleError = null;
        await Task.Yield();

        try
        {
            _result = RoastService.Calculate(input.MeatType, input.WeightKg, input.Doneness);
            _lastInput = input;

            if (input.ServingTime is { } servingTime)
            {
                try
                {
                    _schedule = RoastService.PlanSchedule(
                        input.MeatType,
                        input.WeightKg,
                        input.Doneness,
                        servingTime);
                }
                catch (RoastServiceException ex)
                {
                    _scheduleError = ex.FirstError;
                }
            }
            else
            {
                _schedule = null;
            }
        }
        catch (RoastServiceException ex)
        {
            _weightError = ex.Errors.GetValueOrDefault("weightKg")?.FirstOrDefault();
            _donenessError = ex.Errors.GetValueOrDefault("doneness")?.FirstOrDefault();
            _generalError = ex.FirstError;
        }
        finally
        {
            _isLoading = false;
        }
    }
}
