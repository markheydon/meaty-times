@page "/not-found"
@layout Layout.MainLayout

<PageTitle>Not Found</PageTitle>

<div class="max-w-lg">
    <h1 class="text-2xl font-bold text-gray-900 mb-2">404 - Page Not Found</h1>
    <p class="text-gray-600 mb-6">Sorry, the content you are looking for does not exist.</p>

    <a href="/"
       class="inline-flex items-center gap-2 rounded-lg bg-primary hover:bg-primary-dark text-white font-medium py-2.5 px-4 text-sm transition-colors">
        Go to Home
    </a>
</div>
